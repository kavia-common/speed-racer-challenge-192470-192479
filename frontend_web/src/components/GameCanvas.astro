---
/**
 * GameCanvas.astro
 * Canvas and client-side game engine. Listens for game:* events to start/pause/reset.
 * Renders a responsive canvas with accessible labeling and a data-testid for tests.
 */
const { ariaLabel = 'Race game canvas' } = Astro.props;
---

<div class="game-canvas-wrapper">
  <canvas
    id="game-canvas"
    data-testid="game-canvas"
    aria-label={ariaLabel}
    role="img"
    width="1280"
    height="720"
  >
    Your browser does not support the HTML5 canvas element.
  </canvas>
</div>

<style>
  .game-canvas-wrapper {
    position: relative;
    width: 100%;
    min-height: 320px;
    display: grid;
    place-items: center;
    overflow: hidden;
    border-radius: var(--radius-lg);
  }
  #game-canvas {
    display: block;
    width: 100%;
    height: auto;
    max-height: 70vh;
    background:
      url('/assets/track_pattern.svg') center/cover no-repeat,
      radial-gradient(600px 300px at 20% 0%, rgba(37, 99, 235, 0.08), transparent 60%),
      linear-gradient(180deg, rgba(255,255,255,0.65), rgba(255,255,255,0.35));
    border: 1px solid rgba(17, 24, 39, 0.06);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
  }

  :global(body.dark-theme) #game-canvas {
    background: radial-gradient(600px 300px at 20% 0%, rgba(37, 99, 235, 0.12), transparent 60%),
                linear-gradient(180deg, rgba(15, 23, 42, 0.65), rgba(15, 23, 42, 0.35));
    border-color: rgba(255, 255, 255, 0.08);
  }
</style>

<script type="module" client:load>
  import { createEngine } from '../lib/game/engine';
  import { createCar, integrateCar } from '../lib/game/physics';
  import { createSingleTrack, renderTrack, checkCheckpointHit } from '../lib/game/track';
  import { attachKeyboardInput, attachTouchInput } from '../lib/game/input';

  // PUBLIC_INTERFACE
  /**
   * Initializes the game engine on the provided canvas.
   * Sets up input, a simple track, and one local car with basic arcade physics.
   */
  function initGameCanvas(canvas) {
    /** This is a public function. */
    const engineCtx = {
      car: createCar(140, 140),
      track: createSingleTrack(canvas.width, canvas.height, 3),
      nextCheckpointId: 0,
      laps: 0,
      inputKeyboard: null,
      inputTouch: null,
      startTime: 0,
    };

    // Input
    engineCtx.inputKeyboard = attachKeyboardInput(window);
    engineCtx.inputTouch = attachTouchInput(canvas);

    // Update function: map input to car controls and integrate physics
    const onUpdate = (dt, ctx) => {
      const input = ctx.inputKeyboard?.getState() || { left: false, right: false, up: false, down: false, brake: false };
      const touch = ctx.inputTouch?.getState() || null;

      const effective = {
        left: input.left || (touch ? touch.left : false),
        right: input.right || (touch ? touch.right : false),
        up: input.up || (touch ? touch.up : false),
        down: input.down || (touch ? touch.down : false),
        brake: input.brake || (touch ? touch.brake : false),
      };

      // Map to car inputs
      ctx.car.steer = (effective.left ? -1 : 0) + (effective.right ? 1 : 0);
      ctx.car.throttle = effective.up ? 1 : 0;
      ctx.car.brake = effective.brake || effective.down ? 1 : 0;

      integrateCar(ctx.car, dt);

      // Checkpoint progression and lap counting
      const res = checkCheckpointHit(ctx.track, ctx.nextCheckpointId, ctx.car.position.x, ctx.car.position.y);
      if (res.hit) {
        ctx.nextCheckpointId = res.nextCheckpointId;
        if (res.lapCompleted) {
          ctx.laps += 1;
          // eslint-disable-next-line no-console
          console.log(`Lap completed: ${ctx.laps}`);
        }
      }
    };

    // Render function: clear, draw track and simple car
    const onRender = (ctx2d, dims, state, ctx) => {
      // Clear
      ctx2d.clearRect(0, 0, dims.width, dims.height);

      // Subtle background gradient overlay for Ocean Professional theme
      const grad = ctx2d.createLinearGradient(0, 0, 0, dims.height);
      grad.addColorStop(0, 'rgba(37, 99, 235, 0.10)');
      grad.addColorStop(1, 'rgba(249, 250, 251, 1)');
      ctx2d.fillStyle = grad;
      ctx2d.fillRect(0, 0, dims.width, dims.height);

      // Track
      renderTrack(ctx2d, ctx.track);

      // Car (simple triangle)
      ctx2d.save();
      ctx2d.translate(ctx.car.position.x, ctx.car.position.y);
      ctx2d.rotate(ctx.car.heading);
      ctx2d.fillStyle = '#2563EB';
      ctx2d.strokeStyle = 'rgba(0,0,0,0.15)';
      ctx2d.lineWidth = 2;
      ctx2d.beginPath();
      ctx2d.moveTo(16, 0);
      ctx2d.lineTo(-12, 10);
      ctx2d.lineTo(-12, -10);
      ctx2d.closePath();
      ctx2d.fill();
      ctx2d.stroke();
      ctx2d.restore();

      // HUD stub text (temporary; dedicated HUD component is separate)
      ctx2d.fillStyle = '#111827';
      ctx2d.font = '14px system-ui, -apple-system, Segoe UI, Roboto, Inter, Helvetica, Arial';
      const speed = Math.hypot(ctx.car.velocity.x, ctx.car.velocity.y);
      const elapsedMs = state.time.elapsed;
      const mm = String(Math.floor(elapsedMs / 60000)).padStart(2, '0');
      const ss = String(Math.floor((elapsedMs % 60000) / 1000)).padStart(2, '0');
      const mmm = String(Math.floor(elapsedMs % 1000)).padStart(3, '0');
      ctx2d.fillText(`Speed: ${speed.toFixed(0)} px/s  Lap: ${ctx.laps}  Time: ${mm}:${ss}.${mmm}`, 16, 24);
    };

    const engine = createEngine({
      canvas,
      onUpdate,
      onRender,
      userContext: engineCtx,
      targetFPS: 60,
    });

    // Listen for events from ControlsPanel (or other sources)
    function onStart() {
      // If engine not running or paused, start/resume
      const s = engine.getState();
      if (!s.running) {
        engineCtx.startTime = performance.now();
        engine.start();
      } else if (s.paused) {
        engine.resume();
      }
    }
    function onPause() {
      engine.pause();
    }
    function onReset() {
      // Stop and reinitialize the context (simple reset)
      engine.stop();
      // Reset car and state
      engineCtx.car = createCar(140, 140);
      engineCtx.nextCheckpointId = 0;
      engineCtx.laps = 0;
      // Restart render loop without motion until user starts again
      // We call start->pause to render a fresh frame
      engine.start();
      engine.pause();
    }

    window.addEventListener('game:start', onStart);
    window.addEventListener('game:pause', onPause);
    window.addEventListener('game:reset', onReset);

    // Do not auto-start; wait for Start action
    // engine.start();

    // Clean up on pagehide/unload
    const cleanup = () => {
      window.removeEventListener('game:start', onStart);
      window.removeEventListener('game:pause', onPause);
      window.removeEventListener('game:reset', onReset);
      engine.stop();
      engineCtx.inputKeyboard?.cleanup();
      engineCtx.inputTouch?.cleanup();
    };
    window.addEventListener('pagehide', cleanup, { once: true });
    window.addEventListener('beforeunload', cleanup, { once: true });

    // Draw an initial frame by starting and immediately pausing to ensure canvas is painted
    engine.start();
    engine.pause();
  }

  // Boot
  (function setup() {
    const canvas = document.getElementById('game-canvas');
    if (!(canvas instanceof HTMLCanvasElement)) return;
    initGameCanvas(canvas);
  })();
</script>
