---
/**
 * ControlsPanel.astro
 * On-screen controls and keyboard hints for Start, Pause, Reset.
 * Emits CustomEvents so GameCanvas (or any listener) can react.
 */
const { title = 'Controls' } = Astro.props;
---

<section class="controls" role="region" aria-label="Controls panel">
  <header class="controls-header">
    <h2>{title}</h2>
  </header>

  <div class="controls-actions">
    <button class="btn btn-primary" type="button" aria-label="Start race" data-testid="btn-start" id="btn-start">
      ▶ Start
    </button>
    <button class="btn" type="button" aria-label="Pause race" data-testid="btn-pause" id="btn-pause">
      ⏸ Pause
    </button>
    <button class="btn" type="button" aria-label="Reset race" data-testid="btn-reset" id="btn-reset">
      ⟲ Reset
    </button>
  </div>

  <div class="controls-hints" aria-live="polite">
    <p class="placeholder">
      Keyboard: Arrow keys / WASD to steer · Space to brake · Enter to start
    </p>
  </div>
</section>

<style>
  .controls-header { margin-bottom: .5rem; }
  .controls-header h2 { margin: 0; font-size: 1.1rem; }
  .controls-actions {
    display: flex;
    gap: .5rem;
    flex-wrap: wrap;
  }
  .controls-hints { margin-top: .75rem; }
</style>

<script type="module" client:load>
  // Bridge UI buttons to game control events via CustomEvent on window.
  const startBtn = document.getElementById('btn-start');
  const pauseBtn = document.getElementById('btn-pause');
  const resetBtn = document.getElementById('btn-reset');

  function dispatch(type) {
    window.dispatchEvent(new CustomEvent(`game:${type}`, { bubbles: true }));
  }

  startBtn?.addEventListener('click', () => dispatch('start'));
  pauseBtn?.addEventListener('click', () => dispatch('pause'));
  resetBtn?.addEventListener('click', () => dispatch('reset'));

  // Keyboard convenience: Enter starts/resumes, Space pauses.
  function onKeydown(e) {
    if (e.code === 'Enter') {
      dispatch('start');
    } else if (e.code === 'Space') {
      // prevent page scroll when pausing
      e.preventDefault();
      dispatch('pause');
    }
  }
  window.addEventListener('keydown', onKeydown);

  // Cleanup when page is hidden/unloaded
  const cleanup = () => {
    window.removeEventListener('keydown', onKeydown);
  };
  window.addEventListener('pagehide', cleanup, { once: true });
  window.addEventListener('beforeunload', cleanup, { once: true });
</script>
