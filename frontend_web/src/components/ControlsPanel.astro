---
/**
 * ControlsPanel.astro
 * On-screen controls and keyboard hints for Start, Pause, Reset.
 * Emits CustomEvents so GameCanvas (or any listener) can react.
 */
const { title = 'Controls' } = Astro.props;
---

<section class="controls" role="region" aria-label="Controls panel" style="position:relative; z-index: 2;">
  <header class="controls-header">
    <h2>{title}</h2>
  </header>

  <div class="controls-actions">
    <button class="btn btn-primary" type="button" aria-label="Start race" data-testid="btn-start" id="btn-start">
      ▶ Start
    </button>
    <button class="btn" type="button" aria-label="Pause race" data-testid="btn-pause" id="btn-pause">
      ⏸ Pause
    </button>
    <button class="btn" type="button" aria-label="Reset race" data-testid="btn-reset" id="btn-reset">
      ⟲ Reset
    </button>
  </div>

  <div class="controls-hints" aria-live="polite">
    <p class="placeholder">
      Keyboard: Arrow keys / WASD to steer · Space to brake · Enter to start
    </p>
  </div>
</section>

<style>
  .controls-header { margin-bottom: .5rem; }
  .controls-header h2 { margin: 0; font-size: 1.1rem; }
  .controls-actions {
    display: flex;
    gap: .5rem;
    flex-wrap: wrap;
  }
  .controls-hints { margin-top: .75rem; }
</style>

<script type="module" client:load>
  // Bridge UI buttons to game control events via CustomEvent on window.
  const startBtn = document.getElementById('btn-start');
  const pauseBtn = document.getElementById('btn-pause');
  const resetBtn = document.getElementById('btn-reset');

  function log(...args) {
    // eslint-disable-next-line no-console
    console.debug('[ControlsPanel]', ...args);
  }

  function dispatch(type) {
    try {
      const evName = `game:${type}`;
      log('dispatch', evName);
      window.dispatchEvent(new CustomEvent(evName, { bubbles: true }));
    } catch (err) {
      // eslint-disable-next-line no-console
      console.warn('[ControlsPanel] dispatch error', err);
    }
  }

  // Attach click handlers
  startBtn?.addEventListener('click', () => dispatch('start'));
  pauseBtn?.addEventListener('click', () => dispatch('pause'));
  resetBtn?.addEventListener('click', () => dispatch('reset'));

  // Keyboard convenience: Enter starts/resumes, Space pauses.
  function onKeydown(e) {
    if (e.code === 'Enter') {
      e.preventDefault();
      dispatch('start');
    } else if (e.code === 'Space') {
      // prevent page scroll when pausing
      e.preventDefault();
      dispatch('pause');
    }
  }
  window.addEventListener('keydown', onKeydown);

  // Fallback: if CustomEvents somehow do not reach listeners, attempt direct engine control.
  // The GameCanvas exposes a minimal control bridge on window.__gameCanvasBridge if available.
  function ensureFallbackWire() {
    const bridge = window.__gameCanvasBridge;
    if (!bridge) {
      // Try to locate canvas and poke it to ensure GameCanvas booted
      const cv = document.getElementById('game-canvas');
      if (!cv) {
        log('fallback: canvas not found yet');
      } else {
        log('fallback: canvas present; waiting for GameCanvas bridge...');
      }
      return;
    }
    if (!startBtn || !pauseBtn || !resetBtn) return;
    // Only add once
    if ((startBtn as any)._fallbackBound) return;

    log('fallback: binding direct bridge controls');
    (startBtn as any)._fallbackBound = true;
    startBtn.addEventListener('click', () => { try { bridge.start(); } catch {} });
    pauseBtn.addEventListener('click', () => { try { bridge.pause(); } catch {} });
    resetBtn.addEventListener('click', () => { try { bridge.reset(); } catch {} });
  }

  // Try soon after load; also retry a few times if bridge initializes late
  let tries = 0;
  const maxTries = 20;
  const t = setInterval(() => {
    tries += 1;
    ensureFallbackWire();
    if (tries >= maxTries || window.__gameCanvasBridge) clearInterval(t);
  }, 250);

  // Cleanup when page is hidden/unloaded
  const cleanup = () => {
    window.removeEventListener('keydown', onKeydown);
    clearInterval(t);
  };
  window.addEventListener('pagehide', cleanup, { once: true });
  window.addEventListener('beforeunload', cleanup, { once: true });

  // Initial focus hint to improve keyboard usability
  startBtn?.setAttribute('tabindex', '0');
  pauseBtn?.setAttribute('tabindex', '0');
  resetBtn?.setAttribute('tabindex', '0');
</script>
