---
/**
 * Sidebar.astro
 * Collapsible on small screens via CSS. Contains placeholders for:
 * - Vehicle selection summary
 * - Mini leaderboard
 */
---

<aside class="sidebar">
  <div class="surface section">
    <h3 style="margin:0 0 .5rem 0;">Vehicle</h3>
    <div class="card">
      <div class="placeholder">
        Select your vehicle to see summary here.
      </div>
    </div>
  </div>

  <div class="surface section">
    <h3 style="margin:0 0 .5rem 0;">Mini Leaderboard</h3>
    <div class="card">
      <ul style="margin:0;padding-left:1rem;list-style:disc;color:inherit">
        <li class="placeholder">No race data yet.</li>
      </ul>
    </div>
  </div>
</aside>
