---
import Welcome from '../components/Welcome.astro';
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <Welcome />
  <section class="surface card container" style="margin:1rem auto;">
    <h2 style="margin:.25rem 0;">Jump in</h2>
    <p class="placeholder" style="margin:0 0 .75rem 0">Explore the new routes:</p>
    <div style="display:flex;gap:.5rem;flex-wrap:wrap">
      <a class="btn btn-primary" href="/race">Go to Race</a>
      <a class="btn" href="/garage">Open Garage</a>
      <a class="btn" href="/leaderboard">View Leaderboard</a>
    </div>
  </section>
</Layout>
