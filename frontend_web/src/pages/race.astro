---
import Layout from '../layouts/Layout.astro';
import GameCanvas from '../components/GameCanvas.astro';
import HUD from '../components/HUD.astro';
import ControlsPanel from '../components/ControlsPanel.astro';
import Toast from '../components/Toast.astro';
---

<Layout>
  <section aria-labelledby="race-title" class="race-page">
    <header style="display:flex;align-items:center;justify-content:space-between;gap:.75rem;flex-wrap:wrap;margin-bottom:1rem">
      <div>
        <h1 id="race-title" style="margin:0">Race</h1>
        <p class="placeholder" style="margin:.25rem 0 0 0">
          Use the controls panel to start/pause and steer. This page will render the live game canvas and HUD.
        </p>
      </div>
      <div>
        <span class="badge">Live</span>
      </div>
    </header>

    <Toast kind="info" ariaLive="polite">Press Enter to get ready…</Toast>

    <div class="race-grid">
      <div class="race-main surface card" aria-label="Game area" style="pointer-events:auto; position:relative;">
        <GameCanvas ariaLabel="Race track and vehicles" />
      </div>

      <div class="race-hud surface card" aria-label="Heads-up display">
        <HUD />
      </div>

      <div class="race-controls surface card" aria-label="Controls panel">
        <ControlsPanel />
      </div>

      <aside class="race-sidebar surface card" aria-label="Compact sidebar">
        <h2 style="margin:0 0 .5rem 0;">Quick Stats</h2>
        <div class="placeholder">Vehicle selection, small map preview, recent lap times.</div>
      </aside>
    </div>
  </section>

  <style>
    .race-grid {
      display: grid;
      grid-template-columns: 1.2fr 1fr;
      grid-template-areas:
        "main hud"
        "main controls"
        "main side";
      gap: 1rem;
    }
    .race-main { grid-area: main; min-height: 420px; display: grid; place-items: center; }
    .race-hud { grid-area: hud; }
    .race-controls { grid-area: controls; }
    .race-sidebar { grid-area: side; }

    @media (max-width: 1024px) {
      .race-grid {
        grid-template-columns: 1fr;
        grid-template-areas:
          "main"
          "hud"
          "controls"
          "side";
      }
      .race-main { min-height: 300px; }
    }
  </style>
</Layout>
