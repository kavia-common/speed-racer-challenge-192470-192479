---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <section aria-labelledby="race-title" class="race-page">
    <header style="display:flex;align-items:center;justify-content:space-between;gap:.75rem;flex-wrap:wrap;margin-bottom:1rem">
      <div>
        <h1 id="race-title" style="margin:0">Race</h1>
        <p class="placeholder" style="margin:.25rem 0 0 0">
          Use the controls panel to start/pause and steer. This page will render the live game canvas and HUD.
        </p>
      </div>
      <div>
        <span class="badge">Live</span>
      </div>
    </header>

    <div class="race-grid">
      <div class="race-main surface card" aria-label="Game area">
        <!-- TODO: Replace with <GameCanvas /> -->
        <div class="placeholder" style="text-align:center;padding:1rem">
          GameCanvas will render here (track, vehicles, physics)
        </div>
      </div>

      <div class="race-hud surface card" aria-label="Heads-up display">
        <!-- TODO: Replace with <HUD /> -->
        <h2 style="margin:0 0 .5rem 0;">HUD</h2>
        <ul style="margin:0;padding-left:1.1rem;color:inherit">
          <li class="placeholder">Speed: 0 km/h</li>
          <li class="placeholder">Lap: 0 / 3</li>
          <li class="placeholder">Time: 00:00.000</li>
        </ul>
      </div>

      <div class="race-controls surface card" aria-label="Controls panel">
        <!-- TODO: Replace with <ControlsPanel /> -->
        <h2 style="margin:0 0 .5rem 0;">Controls</h2>
        <div style="display:flex;gap:.5rem;flex-wrap:wrap">
          <button class="btn btn-primary" type="button" aria-label="Start race">Start</button>
          <button class="btn" type="button" aria-label="Pause race">Pause</button>
          <button class="btn" type="button" aria-label="Reset race">Reset</button>
        </div>
        <p class="placeholder" style="margin:.75rem 0 0 0">
          Keyboard: Arrow keys/WASD to steer. Space to brake. Enter to start.
        </p>
      </div>

      <aside class="race-sidebar surface card" aria-label="Compact sidebar">
        <h2 style="margin:0 0 .5rem 0;">Quick Stats</h2>
        <div class="placeholder">Vehicle selection, small map preview, recent lap times.</div>
      </aside>
    </div>
  </section>

  <style>
    .race-grid {
      display: grid;
      grid-template-columns: 1.2fr 1fr;
      grid-template-areas:
        "main hud"
        "main controls"
        "main side";
      gap: 1rem;
    }
    .race-main { grid-area: main; min-height: 420px; display: grid; place-items: center; }
    .race-hud { grid-area: hud; }
    .race-controls { grid-area: controls; }
    .race-sidebar { grid-area: side; }

    @media (max-width: 1024px) {
      .race-grid {
        grid-template-columns: 1fr;
        grid-template-areas:
          "main"
          "hud"
          "controls"
          "side";
      }
      .race-main { min-height: 300px; }
    }
  </style>
</Layout>
