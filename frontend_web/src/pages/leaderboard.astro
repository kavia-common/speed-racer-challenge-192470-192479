---
import Layout from '../layouts/Layout.astro';
import LeaderboardTable from '../components/LeaderboardTable.astro';
---

<Layout>
  <section aria-labelledby="leaderboard-title">
    <header style="margin-bottom:1rem">
      <h1 id="leaderboard-title" style="margin:0">Leaderboard</h1>
      <p class="placeholder" style="margin:.25rem 0 0 0">
        Top times across races. Data loads from backend if configured, with local fallback.
      </p>
    </header>

    <LeaderboardTable title="Top Times" />
  </section>
</Layout>
